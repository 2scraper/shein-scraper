# scraper output — large, machine-specific, stale by the time anyone reads it
*.json
*.csv
!sample_output.json
!sample_output.csv
!tests/fixtures/*.json
shein_results.*
*_debug.html
*_debug.png
live_results/
live/
# raw captures and dumps, by KIND of directory rather than one chosen name
captures/
dump/
dumps/
out/
output/
run/
runs/
result/
results/
tmp/
scratch/
# a page saved at the repo root; the landing page is the one tracked .html
/*.html
!/landing.html
*_challenge/
*.page[0-9]*

# python
__pycache__/
*.py[cod]
.pytest_cache/
.fingerprint_cache/
*.egg-info/
dist/
build/
.venv/
.venv-*/
venv/
env/

# node (puppeteer/selenium tooling, if any local scripts are added later)
node_modules/

# editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# secrets — `.env*` so a `.env.bak`/`.env.local` copy is never one `git add -A` away
*.log
.env*
!.env.example
*.key
secrets*

# sync/transfer artifacts, not part of the repo
*.tar.gz
